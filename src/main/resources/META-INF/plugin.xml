<idea-plugin>
    <id>com.zplflow.intellij</id>
    <name>zplflow — ZPL Live Preview</name>
    <vendor email="support@zplflow.com" url="https://zplflow.com">zplflow</vendor>
    <description><![CDATA[
        Pixel-perfect ZPL thermal label live preview and developer tools powered by zplflow.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="zplflow-lsp.xml">com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="ZPL File"
            implementationClass="com.zplflow.intellij.ZplFileType"
            fieldName="INSTANCE"
            language="ZPL"
            extensions="zpl;prn;label" />
        <toolWindow
            id="zplflow Preview"
            anchor="right"
            factoryClass="com.zplflow.intellij.ZplPreviewToolWindowFactory" />
    </extensions>
</idea-plugin>
